+++ b/app/dispatcher/ratelimit_test.go
@@ -0,0 +1,168 @@
+package dispatcher
+
+import (
+	"context"
+	"os"
+	"path/filepath"
+	"testing"
+	"time"
+
+	"github.com/xtls/xray-core/common"
+	"github.com/xtls/xray-core/common/buf"
+	"github.com/xtls/xray-core/common/session"
+	"github.com/xtls/xray-core/transport"
+	"github.com/xtls/xray-core/transport/pipe"
+)
+
+func TestUpdateRateLimit(t *testing.T) {
+	defer setGlobalRateLimiter(nil)
+
+	dir := t.TempDir()
+	path := filepath.Join(dir, "ratelimit")
+
+	var lastRate int64
+	updateRateLimit(path, &lastRate)
+	if globalRateLimiter.Load() != nil {
+		t.Fatal("expected nil limiter when file does not exist")
+	}
+
+	if err := os.WriteFile(path, []byte("1048576\n"), 0o600); err != nil {
+		t.Fatal(err)
+	}
+	updateRateLimit(path, &lastRate)
+	l1 := globalRateLimiter.Load()
+	if l1 == nil {
+		t.Fatal("expected non-nil limiter for positive rate")
+	}
+	if lastRate != 1048576 {
+		t.Fatalf("expected lastRate 1048576, got %d", lastRate)
+	}
+
+	updateRateLimit(path, &lastRate)
+	if globalRateLimiter.Load() != l1 {
+		t.Fatal("expected limiter pointer to remain unchanged when rate is unchanged")
+	}
+
+	w := &rateLimitWriter{Writer: buf.Discard, Ctx: context.Background()}
+	mb := buf.MergeBytes(nil, []byte("hello"))
+	common.Must(w.WriteMultiBuffer(mb))
+
+	if err := os.WriteFile(path, []byte("0\n"), 0o600); err != nil {
+		t.Fatal(err)
+	}
+	updateRateLimit(path, &lastRate)
+	if globalRateLimiter.Load() != nil {
+		t.Fatal("expected nil limiter when rate is 0")
+	}
+}
+
+func TestWaitRateLimitCtxCancel(t *testing.T) {
+	defer setGlobalRateLimiter(nil)
+
+	l := newRateLimiter(100)
+	// Drain initial burst so subsequent wait must sleep.
+	l.mu.Lock()
+	l.tokens = 0
+	l.mu.Unlock()
+	setGlobalRateLimiter(l)
+
+	ctx, cancel := context.WithTimeout(context.Background(), 30*time.Millisecond)
+	defer cancel()
+
+	start := time.Now()
+	waitRateLimit(ctx, 10000)
+	elapsed := time.Since(start)
+	if elapsed > 250*time.Millisecond {
+		t.Fatalf("waitRateLimit did not abort promptly on ctx cancel: %v", elapsed)
+	}
+}
+
+func TestWaitRateLimitResetToZero(t *testing.T) {
+	defer setGlobalRateLimiter(nil)
+
+	l := newRateLimiter(100)
+	l.mu.Lock()
+	l.tokens = 0
+	l.mu.Unlock()
+	setGlobalRateLimiter(l)
+
+	done := make(chan time.Duration, 1)
+	go func() {
+		start := time.Now()
+		waitRateLimit(context.Background(), 10000)
+		done <- time.Since(start)
+	}()
+
+	time.Sleep(25 * time.Millisecond)
+	setGlobalRateLimiter(nil)
+
+	select {
+	case elapsed := <-done:
+		if elapsed > 250*time.Millisecond {
+			t.Fatalf("waitRateLimit did not wake promptly on limiter reset: %v", elapsed)
+		}
+	case <-time.After(500 * time.Millisecond):
+		t.Fatal("waitRateLimit hung after limiter was reset to nil")
+	}
+}
+
+func TestInternalAPIBypass(t *testing.T) {
+	prev := globalRateLimitEnabled
+	globalRateLimitEnabled = true
+	defer func() { globalRateLimitEnabled = prev }()
+
+	d := &DefaultDispatcher{}
+
+	apiInCtx := session.ContextWithInbound(context.Background(), &session.Inbound{Tag: apiInboundTag})
+	inLink, outLink := d.getLink(apiInCtx)
+	if _, ok := inLink.Writer.(*rateLimitWriter); ok {
+		t.Fatal("expected REMNAWAVE_API_INBOUND uplink writer not to be rate-limited")
+	}
+	if _, ok := outLink.Writer.(*rateLimitWriter); ok {
+		t.Fatal("expected REMNAWAVE_API_INBOUND downlink writer not to be rate-limited")
+	}
+
+	r, w := pipe.New()
+	wrapped := WrapLink(apiInCtx, nil, nil, &transport.Link{Reader: r, Writer: w})
+	if _, ok := wrapped.Reader.(*rateLimitReader); ok {
+		t.Fatal("expected REMNAWAVE_API_INBOUND WrapLink reader not to be rate-limited")
+	}
+	if _, ok := wrapped.Writer.(*rateLimitWriter); ok {
+		t.Fatal("expected REMNAWAVE_API_INBOUND WrapLink writer not to be rate-limited")
+	}
+
+	apiOutCtx := session.ContextWithOutbounds(context.Background(), []*session.Outbound{{Tag: apiOutboundTag}})
+	r2, w2 := pipe.New()
+	wrapped2 := WrapLink(apiOutCtx, nil, nil, &transport.Link{Reader: r2, Writer: w2})
+	if _, ok := wrapped2.Reader.(*rateLimitReader); ok {
+		t.Fatal("expected REMNAWAVE_API outbound WrapLink reader not to be rate-limited")
+	}
+	if _, ok := wrapped2.Writer.(*rateLimitWriter); ok {
+		t.Fatal("expected REMNAWAVE_API outbound WrapLink writer not to be rate-limited")
+	}
+}
+
+func TestWrapLinkUplinkAndNoDoubleWrap(t *testing.T) {
+	prev := globalRateLimitEnabled
+	globalRateLimitEnabled = true
+	defer func() { globalRateLimitEnabled = prev }()
+
+	r, w := pipe.New()
+	normalLink := WrapLink(context.Background(), nil, nil, &transport.Link{Reader: r, Writer: w})
+	if _, ok := normalLink.Reader.(*rateLimitReader); !ok {
+		t.Fatalf("expected WrapLink reader to be *rateLimitReader, got %T", normalLink.Reader)
+	}
+	if _, ok := normalLink.Writer.(*rateLimitWriter); !ok {
+		t.Fatalf("expected WrapLink writer to be *rateLimitWriter, got %T", normalLink.Writer)
+	}
+
+	r2, w2 := pipe.New()
+	markedCtx := markRateLimitedContext(context.Background())
+	muxLink := WrapLink(markedCtx, nil, nil, &transport.Link{Reader: r2, Writer: w2})
+	if _, ok := muxLink.Reader.(*rateLimitReader); ok {
+		t.Fatal("expected marked (mux sub-stream) WrapLink reader not to be double-wrapped")
+	}
+	if _, ok := muxLink.Writer.(*rateLimitWriter); ok {
+		t.Fatal("expected marked (mux sub-stream) WrapLink writer not to be double-wrapped")
+	}
+}
diff --git a/app/dispatcher/stats.go b/app/dispatcher/stats.go
index 8fac019..126dcb0 100644
--- a/app/dispatcher/stats.go
+++ b/app/dispatcher/stats.go
@@ -1,17 +1,24 @@
 package dispatcher
 
 import (
+	"context"
+
 	"github.com/xtls/xray-core/common"
 	"github.com/xtls/xray-core/common/buf"
 	"github.com/xtls/xray-core/features/stats"
 )
 
 type SizeStatWriter struct {
-	Counter stats.Counter
-	Writer  buf.Writer
+	Counter       stats.Counter
+	Writer        buf.Writer
+	Ctx           context.Context
+	SkipRateLimit bool
 }
 
 func (w *SizeStatWriter) WriteMultiBuffer(mb buf.MultiBuffer) error {
+	if !w.SkipRateLimit {
+		waitRateLimit(w.Ctx, int64(mb.Len()))
+	}
 	w.Counter.Add(int64(mb.Len()))
 	return w.Writer.WriteMultiBuffer(mb)
 }
