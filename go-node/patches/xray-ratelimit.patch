diff --git a/app/dispatcher/ratelimit.go b/app/dispatcher/ratelimit.go
new file mode 100644
index 0000000..529d507
--- /dev/null
+++ b/app/dispatcher/ratelimit.go
@@ -0,0 +1,293 @@
+package dispatcher
+
+import (
+	"context"
+	"fmt"
+	"os"
+	"path/filepath"
+	"strconv"
+	"strings"
+	"sync"
+	"sync/atomic"
+
+	"time"
+
+	"github.com/xtls/xray-core/common"
+	"github.com/xtls/xray-core/common/buf"
+	"github.com/xtls/xray-core/common/session"
+)
+
+const (
+	rateLimitEnvVar       = "XRAY_RATELIMIT_FILE_V2"
+	rateLimitPollInterval = 500 * time.Millisecond
+
+	apiInboundTag  = "REMNAWAVE_API_INBOUND"
+	apiOutboundTag = "REMNAWAVE_API"
+)
+
+type rateLimitMarkKey struct{}
+
+var (
+	globalRateLimiter      = newRateLimiter()
+	globalRateLimitEnabled bool
+)
+
+func init() {
+	path := os.Getenv(rateLimitEnvVar)
+	if path == "" {
+		path = os.Getenv("XRAY_RATELIMIT_FILE")
+	} // older node supervisors
+	if path == "" {
+		return
+	}
+	globalRateLimitEnabled = true
+	_ = os.Remove(path + ".traffic") // The preceding core may have exited between samples.
+	var lastRate int64
+	last := time.Now()
+	var prev uint64
+	updateRateLimit(path, &lastRate)
+	go func() {
+		ticker := time.NewTicker(rateLimitPollInterval)
+		defer ticker.Stop()
+		for now := range ticker.C {
+			updateRateLimit(path, &lastRate)
+			if elapsed := now.Sub(last); elapsed >= 900*time.Millisecond {
+				total := transferred.Load()
+				bps := int64(float64(total-prev) / elapsed.Seconds())
+				publishTraffic(path+".traffic", now, bps, globalRateLimiter.queued())
+				last, prev = now, total
+			}
+		}
+	}()
+}
+
+func updateRateLimit(path string, lastRate *int64) {
+	data, err := os.ReadFile(path)
+	if err != nil {
+		if os.IsNotExist(err) && *lastRate != 0 {
+			*lastRate = 0
+			globalRateLimiter.setRate(0)
+		}
+		return
+	}
+	s := strings.TrimSpace(string(data))
+	var rate int64
+	if s != "" {
+		parsed, err := strconv.ParseInt(s, 10, 64)
+		if err != nil {
+			return
+		}
+		rate = parsed
+	}
+	if rate < 0 {
+		rate = 0
+	}
+	if rate == *lastRate {
+		return
+	}
+	*lastRate = rate
+	globalRateLimiter.setRate(rate)
+}
+
+// ShouldPace keeps managed connections on the observable copy path for their lifetime.
+func ShouldPace(ctx context.Context) bool {
+	return globalRateLimitEnabled && !isInternalAPITraffic(ctx)
+}
+
+func isInternalAPITraffic(ctx context.Context) bool {
+	if ctx == nil {
+		return false
+	}
+	if inbound := session.InboundFromContext(ctx); inbound != nil && inbound.Tag == apiInboundTag {
+		return true
+	}
+	if session.GetForcedOutboundTagFromContext(ctx) == apiOutboundTag {
+		return true
+	}
+	for _, ob := range session.OutboundsFromContext(ctx) {
+		if ob != nil && ob.Tag == apiOutboundTag {
+			return true
+		}
+	}
+	return false
+}
+
+func markRateLimitedContext(ctx context.Context) context.Context {
+	if ctx == nil {
+		return nil
+	}
+	return context.WithValue(ctx, rateLimitMarkKey{}, true)
+}
+
+func isRateLimitedContext(ctx context.Context) bool {
+	if ctx == nil {
+		return false
+	}
+	v, _ := ctx.Value(rateLimitMarkKey{}).(bool)
+	return v
+}
+
+var transferred atomic.Uint64
+
+func publishTraffic(path string, now time.Time, bps int64, queued int) {
+	f, err := os.CreateTemp(filepath.Dir(path), ".rw-traffic-")
+	if err != nil {
+		return
+	}
+	defer os.Remove(f.Name())
+	_, err = fmt.Fprintf(f, "%d %d %d\n", now.UnixNano(), bps, queued)
+	closeErr := f.Close()
+	if err == nil && closeErr == nil {
+		_ = os.Rename(f.Name(), path)
+	}
+}
+
+type rateLimitWriter struct {
+	Writer buf.Writer
+	Ctx    context.Context
+	flow   *rateFlow
+	cancel context.CancelFunc
+}
+
+// Timeout-only XUDP links survive the cancellation of the mux transport.
+// Closing or interrupting the logical direction still cancels its grants.
+func pacingContext(parent context.Context) (context.Context, context.CancelFunc) {
+	if session.TimeoutOnlyFromContext(parent) {
+		parent = context.WithoutCancel(parent)
+	}
+	return context.WithCancel(parent)
+}
+
+func newPacedWriter(parent context.Context, writer buf.Writer, flow *rateFlow) *rateLimitWriter {
+	ctx, cancel := pacingContext(parent)
+	return &rateLimitWriter{Writer: writer, Ctx: ctx, flow: flow, cancel: cancel}
+}
+
+// Keep datagrams intact when returning part of a MultiBuffer. An oversized
+// datagram acquires multiple grants and is passed downstream in one piece.
+func batchSize(mb buf.MultiBuffer) int {
+	if globalRateLimiter.isActive() {
+		var size int64
+		for i, b := range mb {
+			size += int64(b.Len())
+			if i > 0 && size > quantum {
+				return i
+			}
+		}
+	}
+	return len(mb)
+}
+
+func (w *rateLimitWriter) WriteMultiBuffer(mb buf.MultiBuffer) error {
+	if len(mb) == 0 {
+		return w.Writer.WriteMultiBuffer(mb)
+	}
+	for len(mb) > 0 {
+		count := batchSize(mb)
+		batch := mb[:count:count]
+		n := int64(batch.Len())
+		if err := globalRateLimiter.wait(w.Ctx, w.flow, n); err != nil {
+			buf.ReleaseMulti(mb)
+			return err
+		}
+		mb = mb[count:]
+		if err := w.Writer.WriteMultiBuffer(batch); err != nil {
+			buf.ReleaseMulti(mb)
+			return err
+		}
+		transferred.Add(uint64(n))
+	}
+	return nil
+}
+func (w *rateLimitWriter) Close() error {
+	w.cancel()
+	return common.Close(w.Writer)
+}
+func (w *rateLimitWriter) Interrupt() {
+	w.cancel()
+	common.Interrupt(w.Writer)
+}
+
+type rateLimitReader struct {
+	Reader buf.TimeoutReader
+	ctx    context.Context
+	cancel context.CancelFunc
+	flow   *rateFlow
+
+	// The link has one reader. Close/Interrupt may discard a buffered tail concurrently.
+	mu          sync.Mutex
+	pending     buf.MultiBuffer
+	trailingErr error
+	prepaid     int64 // granted bytes retained across a timed-out read
+}
+
+func newPacedReader(parent context.Context, reader buf.TimeoutReader, flow *rateFlow) *rateLimitReader {
+	ctx, cancel := pacingContext(parent)
+	return &rateLimitReader{Reader: reader, ctx: ctx, cancel: cancel, flow: flow}
+}
+func (r *rateLimitReader) read(ctx context.Context, fetch func() (buf.MultiBuffer, error)) (buf.MultiBuffer, error) {
+	if err := r.ctx.Err(); err != nil {
+		return nil, err
+	}
+	r.mu.Lock()
+	if len(r.pending) == 0 {
+		r.mu.Unlock()
+		mb, err := fetch()
+		r.mu.Lock()
+		r.pending, r.trailingErr = mb, err
+	}
+	if err := r.ctx.Err(); err != nil {
+		r.pending = buf.ReleaseMulti(r.pending)
+		r.mu.Unlock()
+		return nil, err
+	}
+	defer r.mu.Unlock()
+	n := batchSize(r.pending)
+	mb := r.pending[:n:n]
+	size := int64(mb.Len())
+	if size > 0 {
+		remaining := size - r.prepaid
+		if err := globalRateLimiter.waitRemaining(ctx, r.flow, &remaining); err != nil {
+			r.prepaid = size - remaining
+			if r.ctx.Err() == nil && err == context.DeadlineExceeded {
+				return nil, buf.ErrReadTimeout
+			}
+			r.pending = buf.ReleaseMulti(r.pending)
+			return nil, err
+		}
+	}
+	r.prepaid = 0
+	r.pending = r.pending[n:]
+	var err error
+	if len(r.pending) == 0 {
+		r.pending = nil
+		err, r.trailingErr = r.trailingErr, nil
+	}
+	transferred.Add(uint64(size))
+	return mb, err
+}
+
+func (r *rateLimitReader) ReadMultiBuffer() (buf.MultiBuffer, error) {
+	return r.read(r.ctx, r.Reader.ReadMultiBuffer)
+}
+func (r *rateLimitReader) ReadMultiBufferTimeout(t time.Duration) (buf.MultiBuffer, error) {
+	deadline := time.Now().Add(t)
+	ctx, cancel := context.WithDeadline(r.ctx, deadline)
+	defer cancel()
+	return r.read(ctx, func() (buf.MultiBuffer, error) { return r.Reader.ReadMultiBufferTimeout(time.Until(deadline)) })
+}
+
+func (r *rateLimitReader) stop() {
+	r.cancel()
+	r.mu.Lock()
+	r.pending = buf.ReleaseMulti(r.pending)
+	r.mu.Unlock()
+}
+func (r *rateLimitReader) Close() error {
+	r.stop()
+	return common.Close(r.Reader)
+}
+func (r *rateLimitReader) Interrupt() {
+	r.stop()
+	common.Interrupt(r.Reader)
+}
