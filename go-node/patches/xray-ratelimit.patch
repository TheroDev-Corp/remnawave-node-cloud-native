+package dispatcher_test
+
+import (
+	"context"
+	"github.com/xtls/xray-core/app/dispatcher"
+	"testing"
+	"time"
+
+	"github.com/xtls/xray-core/common/buf"
+	"github.com/xtls/xray-core/common/mux"
+	"github.com/xtls/xray-core/common/net"
+	"github.com/xtls/xray-core/common/session"
+	"github.com/xtls/xray-core/transport"
+	"github.com/xtls/xray-core/transport/pipe"
+)
+
+type xudpTestDispatcher struct {
+	dispatcher.DefaultDispatcher
+	opened chan *transport.Link
+}
+
+func (d *xudpTestDispatcher) Dispatch(ctx context.Context, _ net.Destination) (*transport.Link, error) {
+	in, out := d.PacedTestLinks(ctx)
+	d.opened <- out
+	return in, nil
+}
+
+func TestXUDPReconnectKeepsPacedLink(t *testing.T) {
+	setRate, restore := dispatcher.EnablePacingForTest()
+	defer restore()
+	d := &xudpTestDispatcher{opened: make(chan *transport.Link, 2)}
+	target := net.UDPDestination(net.LocalHostIP, 8053)
+	id := [8]byte{'p', 'a', 'c', 'e', 'd', 'u', 'd', 'p'}
+	defer func() {
+		mux.XUDPManager.Lock()
+		x := mux.XUDPManager.Map[id]
+		delete(mux.XUDPManager.Map, id)
+		mux.XUDPManager.Unlock()
+		if x != nil {
+			x.Interrupt()
+		}
+	}()
+	attach := func(b byte) func() {
+		ctx, cancel := context.WithCancel(session.ContextWithOutbounds(context.Background(), []*session.Outbound{{}}))
+		r, w := pipe.New()
+		worker, err := mux.NewServerWorker(ctx, d, &transport.Link{Reader: r, Writer: buf.Discard})
+		if err != nil {
+			t.Fatal(err)
+		}
+		packet := buf.New()
+		packet.UDP = &target
+		meta := mux.FrameMetadata{GlobalID: id, SessionID: 1, SessionStatus: mux.SessionStatusNew, Option: mux.OptionData, Target: target}
+		if err := meta.WriteTo(packet); err != nil {
+			t.Fatal(err)
+		}
+		packet.Write([]byte{0, 1, b})
+		if err := w.WriteMultiBuffer(buf.MultiBuffer{packet}); err != nil {
+			t.Fatal(err)
+		}
+		return func() {
+			cancel()
+			w.Close()
+			<-worker.WaitClosed()
+			until := time.Now().Add(time.Second)
+			for time.Now().Before(until) {
+				mux.XUDPManager.Lock()
+				x := mux.XUDPManager.Map[id]
+				detached := x != nil && x.Status == mux.Expiring
+				mux.XUDPManager.Unlock()
+				if detached {
+					return
+				}
+				time.Sleep(time.Millisecond)
+			}
+			t.Fatal("mux did not detach")
+		}
+	}
+	detach := attach('a')
+	var link *transport.Link
+	select {
+	case link = <-d.opened:
+	case <-time.After(time.Second):
+		t.Fatal("missing UDP dispatch")
+	}
+	read := func(want string) {
+		mb, err := link.Reader.(buf.TimeoutReader).ReadMultiBufferTimeout(time.Second)
+		defer buf.ReleaseMulti(mb)
+		if err != nil || mb.String() != want {
+			t.Fatalf("original UDP link: got %q, %v; want %q", mb.String(), err, want)
+		}
+	}
+	read("a")
+	detach()
+	setRate(1_000_000)
+	detach = attach('b')
+	read("b")
+	detach()
+	select {
+	case <-d.opened:
+		t.Fatal("reconnect dispatched a replacement link")
+	default:
+	}
+}
