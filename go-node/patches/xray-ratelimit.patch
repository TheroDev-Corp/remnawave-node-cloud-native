+package dispatcher
+
+import (
+	"bytes"
+	"container/heap"
+	"context"
+	"fmt"
+	"os"
+	"path/filepath"
+	"testing"
+	"time"
+
+	"github.com/xtls/xray-core/common"
+	"github.com/xtls/xray-core/common/buf"
+	"github.com/xtls/xray-core/common/net"
+	"github.com/xtls/xray-core/common/session"
+	"github.com/xtls/xray-core/features/outbound"
+	"github.com/xtls/xray-core/transport"
+	"github.com/xtls/xray-core/transport/pipe"
+)
+
+func TestUpdateRateLimit(t *testing.T) {
+	prev := globalRateLimitEnabled
+	globalRateLimitEnabled = true
+	defer func() {
+		globalRateLimitEnabled = prev
+		globalRateLimiter.setRate(0)
+	}()
+
+	dir := t.TempDir()
+	path := filepath.Join(dir, "ratelimit")
+
+	var lastRate int64
+	updateRateLimit(path, &lastRate)
+	if globalRateLimiter.isActive() {
+		t.Fatal("expected inactive limiter when file does not exist")
+	}
+
+	if err := os.WriteFile(path, []byte("1048576\n"), 0o600); err != nil {
+		t.Fatal(err)
+	}
+	updateRateLimit(path, &lastRate)
+	if !globalRateLimiter.isActive() {
+		t.Fatal("expected active limiter for positive rate")
+	}
+	if lastRate != 1048576 {
+		t.Fatalf("expected lastRate 1048576, got %d", lastRate)
+	}
+
+	w := &rateLimitWriter{Writer: buf.Discard, Ctx: context.Background(), flow: new(rateFlow)}
+	mb := buf.MergeBytes(nil, []byte("hello"))
+	common.Must(w.WriteMultiBuffer(mb))
+
+	if err := os.WriteFile(path, []byte("0\n"), 0o600); err != nil {
+		t.Fatal(err)
+	}
+	updateRateLimit(path, &lastRate)
+	if globalRateLimiter.isActive() {
+		t.Fatal("expected inactive limiter when rate is 0")
+	}
+}
+
+func TestRateChangeAndCancel(t *testing.T) {
+	l := newRateLimiter()
+	l.setRate(1)
+	ctx, cancel := context.WithCancel(context.Background())
+	defer cancel()
+	wait := func() chan error {
+		ch := make(chan error, 1)
+		go func() { ch <- l.wait(ctx, new(rateFlow), quantum) }()
+		deadline := time.Now().Add(time.Second)
+		for l.queued() == 0 && time.Now().Before(deadline) {
+			time.Sleep(time.Millisecond)
+		}
+		if l.queued() == 0 {
+			t.Fatal("request did not enter the queue")
+		}
+		return ch
+	}
+	first := wait()
+	l.setRate(2)
+	select {
+	case <-first:
+		t.Fatal("positive rate change released request")
+	default:
+	}
+	cancel()
+	if err := <-first; err != context.Canceled {
+		t.Fatal(err)
+	}
+	if l.queued() != 0 {
+		t.Fatal("cancel retained request")
+	}
+	ctx = context.Background()
+	second := wait()
+	l.setRate(0)
+	if err := <-second; err != nil {
+		t.Fatal(err)
+	}
+}
+
+func TestVirtualByteService(t *testing.T) {
+	for _, flows := range []int{2, 4} {
+		var q grantQueue
+		var sent [4]int64
+		owner := map[*grant]int{}
+		for i := 0; i < flows; i++ {
+			size := int64(quantum / (1 + i))
+			for j := 1; j <= 100; j++ {
+				g := &grant{bytes: size, finish: uint64(int64(j) * size)}
+				owner[g] = i
+				heap.Push(&q, g)
+			}
+		}
+		for q.Len() > 0 {
+			g := heap.Pop(&q).(*grant)
+			i := owner[g]
+			sent[i] += g.bytes
+			if sent[i] >= 12*quantum {
+				break
+			}
+		}
+		for _, n := range sent[:flows] {
+			if n < 11*quantum || n > 13*quantum {
+				t.Fatalf("unequal service: %v", sent)
+			}
+		}
+	}
+}
+
+type collectingWriter struct{ packets [][]byte }
+
+func (w *collectingWriter) WriteMultiBuffer(mb buf.MultiBuffer) error {
+	defer buf.ReleaseMulti(mb)
+	for _, b := range mb {
+		w.packets = append(w.packets, append([]byte(nil), b.Bytes()...))
+	}
+	return nil
+}
+
+func TestPacingPreservesPacketBoundaries(t *testing.T) {
+	globalRateLimiter.setRate(10_000_000)
+	defer globalRateLimiter.setRate(0)
+	next := new(collectingWriter)
+	w := rateLimitWriter{Writer: next, Ctx: context.Background(), flow: new(rateFlow)}
+	var mb buf.MultiBuffer
+	for i := 0; i < 32; i++ {
+		b := buf.New()
+		b.Write(bytes.Repeat([]byte{byte(i)}, 1024))
+		mb = append(mb, b)
+	}
+	if err := w.WriteMultiBuffer(mb); err != nil {
+		t.Fatal(err)
+	}
+	if len(next.packets) != 32 {
+		t.Fatal(len(next.packets))
+	}
+	for i, b := range next.packets {
+		if !bytes.Equal(b, bytes.Repeat([]byte{byte(i)}, 1024)) {
+			t.Fatal(i)
+		}
+	}
+}
+
+func TestInternalAPIBypass(t *testing.T) {
+	prev := globalRateLimitEnabled
+	globalRateLimitEnabled = true
+	defer func() {
+		globalRateLimitEnabled = prev
+		globalRateLimiter.setRate(0)
+	}()
+	globalRateLimiter.setRate(100000)
+
+	d := &DefaultDispatcher{}
+
+	apiInCtx := session.ContextWithInbound(context.Background(), &session.Inbound{Tag: apiInboundTag})
+	inLink, outLink := d.getLink(apiInCtx)
+	if _, ok := inLink.Writer.(*rateLimitWriter); ok {
+		t.Fatal("expected REMNAWAVE_API_INBOUND uplink writer not to be rate-limited")
+	}
+	if _, ok := outLink.Writer.(*rateLimitWriter); ok {
+		t.Fatal("expected REMNAWAVE_API_INBOUND downlink writer not to be rate-limited")
+	}
+
+	r, w := pipe.New()
+	wrapped := WrapLink(apiInCtx, nil, nil, &transport.Link{Reader: r, Writer: w})
+	if _, ok := wrapped.Reader.(*rateLimitReader); ok {
+		t.Fatal("expected REMNAWAVE_API_INBOUND WrapLink reader not to be rate-limited")
+	}
+	if _, ok := wrapped.Writer.(*rateLimitWriter); ok {
+		t.Fatal("expected REMNAWAVE_API_INBOUND WrapLink writer not to be rate-limited")
+	}
+
+	apiOutCtx := session.ContextWithOutbounds(context.Background(), []*session.Outbound{{Tag: apiOutboundTag}})
+	r2, w2 := pipe.New()
+	wrapped2 := WrapLink(apiOutCtx, nil, nil, &transport.Link{Reader: r2, Writer: w2})
+	if _, ok := wrapped2.Reader.(*rateLimitReader); ok {
+		t.Fatal("expected REMNAWAVE_API outbound WrapLink reader not to be rate-limited")
+	}
+	if _, ok := wrapped2.Writer.(*rateLimitWriter); ok {
+		t.Fatal("expected REMNAWAVE_API outbound WrapLink writer not to be rate-limited")
+	}
+}
+
+func TestWrapLinkUplinkAndNoDoubleWrap(t *testing.T) {
+	prev := globalRateLimitEnabled
+	globalRateLimitEnabled = true
+	defer func() {
+		globalRateLimitEnabled = prev
+		globalRateLimiter.setRate(0)
+	}()
+	globalRateLimiter.setRate(100000)
+
+	r, w := pipe.New()
+	normalLink := WrapLink(context.Background(), nil, nil, &transport.Link{Reader: r, Writer: w})
+	if _, ok := normalLink.Reader.(*rateLimitReader); !ok {
+		t.Fatalf("expected WrapLink reader to be *rateLimitReader, got %T", normalLink.Reader)
+	}
+	if _, ok := normalLink.Writer.(*rateLimitWriter); !ok {
+		t.Fatalf("expected WrapLink writer to be *rateLimitWriter, got %T", normalLink.Writer)
+	}
+
+	r2, w2 := pipe.New()
+	markedCtx := markRateLimitedContext(context.Background())
+	muxLink := WrapLink(markedCtx, nil, nil, &transport.Link{Reader: r2, Writer: w2})
+	if _, ok := muxLink.Reader.(*rateLimitReader); ok {
+		t.Fatal("expected marked (mux sub-stream) WrapLink reader not to be double-wrapped")
+	}
+	if _, ok := muxLink.Writer.(*rateLimitWriter); ok {
+		t.Fatal("expected marked (mux sub-stream) WrapLink writer not to be double-wrapped")
+	}
+
+	d := &DefaultDispatcher{}
+	inLink, outLink := d.getLink(markedCtx)
+	if _, ok := inLink.Writer.(*rateLimitWriter); ok {
+		t.Fatal("expected marked getLink uplink writer not to be double-wrapped")
+	}
+	if _, ok := outLink.Writer.(*rateLimitWriter); ok {
+		t.Fatal("expected marked getLink downlink writer not to be double-wrapped")
+	}
+}
+
+type dummyOutboundManager struct {
+	outbound.Manager
+}
+
+func (d *dummyOutboundManager) GetDefaultHandler() outbound.Handler { return nil }
+func (d *dummyOutboundManager) GetHandler(string) outbound.Handler  { return nil }
+
+func TestDispatchLinkMarksContext(t *testing.T) {
+	prev := globalRateLimitEnabled
+	globalRateLimitEnabled = true
+	defer func() {
+		globalRateLimitEnabled = prev
+		globalRateLimiter.setRate(0)
+	}()
+	globalRateLimiter.setRate(100000)
+
+	d := &DefaultDispatcher{ohm: &dummyOutboundManager{}}
+	ctx := context.Background()
+	r, w := pipe.New()
+	link := &transport.Link{Reader: r, Writer: w}
+	dest := net.Destination{Network: net.Network_TCP, Address: net.LocalHostIP, Port: 80}
+
+	// DispatchLink wraps outbound and marks ctx
+	_ = d.DispatchLink(ctx, dest, link)
+
+	markedCtx := markRateLimitedContext(ctx)
+	inLink, outLink := d.getLink(markedCtx)
+	if _, ok := inLink.Writer.(*rateLimitWriter); ok {
+		t.Fatal("expected getLink on marked context to skip rate limit")
+	}
+	if _, ok := outLink.Writer.(*rateLimitWriter); ok {
+		t.Fatal("expected getLink on marked context to skip rate limit")
+	}
+}
+
+func TestManagedTrafficAlwaysPaced(t *testing.T) {
+	prev := globalRateLimitEnabled
+	defer func() { globalRateLimitEnabled = prev }()
+	for _, enabled := range []bool{false, true} {
+		globalRateLimitEnabled = enabled
+		if ShouldPace(context.Background()) != enabled {
+			t.Fatal(enabled)
+		}
+		ctx := session.ContextWithInbound(context.Background(), &session.Inbound{Tag: apiInboundTag})
+		if ShouldPace(ctx) {
+			t.Fatal("paced control plane")
+		}
+	}
+}
+
+func TestClosingDirectionReleasesGrant(t *testing.T) {
+	globalRateLimiter.setRate(1)
+	defer globalRateLimiter.setRate(0)
+	flow := new(rateFlow)
+	w := newPacedWriter(context.Background(), buf.Discard, flow)
+	done := make(chan error, 1)
+	go func() { done <- w.WriteMultiBuffer(buf.MergeBytes(nil, []byte("waiting"))) }()
+	deadline := time.Now().Add(time.Second)
+	for globalRateLimiter.queued() == 0 && time.Now().Before(deadline) {
+		time.Sleep(time.Millisecond)
+	}
+	if globalRateLimiter.queued() == 0 {
+		t.Fatal("no queued write")
+	}
+	w.Close()
+	select {
+	case err := <-done:
+		if err != context.Canceled {
+			t.Fatal(err)
+		}
+	case <-time.After(time.Second):
+		t.Fatal("close left a waiter")
+	}
+}
+
+func TestShortWriteWhileBulkWaits(t *testing.T) {
+	l := newRateLimiter()
+	l.setRate(1)
+	defer l.setRate(0)
+	enqueue := func(size int64, want int) <-chan error {
+		result := make(chan error, 1)
+		go func() { result <- l.wait(context.Background(), new(rateFlow), size) }()
+		deadline := time.Now().Add(time.Second)
+		for l.queued() != want && time.Now().Before(deadline) {
+			time.Sleep(time.Millisecond)
+		}
+		if l.queued() != want {
+			t.Fatal("unexpected queue length", l.queued())
+		}
+		return result
+	}
+	bulk := enqueue(quantum, 1)
+	short := enqueue(16, 2)
+	l.mu.Lock()
+	l.tokens = 16
+	l.signal()
+	l.mu.Unlock()
+	select {
+	case err := <-short:
+		if err != nil {
+			t.Fatal(err)
+		}
+	case <-time.After(time.Second):
+		t.Fatal("small request stalled behind bulk transfer")
+	}
+	select {
+	case <-bulk:
+		t.Fatal("bulk write exceeded its grant")
+	default:
+	}
+}
+
+func TestCoreStartupReusesCurrentRate(t *testing.T) {
+	defer globalRateLimiter.setRate(0)
+	path := filepath.Join(t.TempDir(), "rate")
+	if err := os.WriteFile(path, []byte("1250000"), 0600); err != nil {
+		t.Fatal(err)
+	}
+	var initial int64
+	updateRateLimit(path, &initial)
+	if globalRateLimiter.rate.Load() != 1250000 {
+		t.Fatal("missing startup rate")
+	}
+	now := time.Now()
+	publishTraffic(path+".traffic", now, 0, 0)
+	data, err := os.ReadFile(path + ".traffic")
+	if err != nil {
+		t.Fatal(err)
+	}
+	if string(data) != fmt.Sprintf("%d 0 0\n", now.UnixNano()) {
+		t.Fatalf("restart telemetry: %q", data)
+	}
+}
diff --git a/app/dispatcher/ratescheduler.go b/app/dispatcher/ratescheduler.go
new file mode 100644
index 0000000..ac8b056
--- /dev/null
+++ b/app/dispatcher/ratescheduler.go
@@ -0,0 +1,173 @@
+package dispatcher
+
+import (
+	"container/heap"
+	"context"
+	"sync"
+	"sync/atomic"
+	"time"
+)
+
+const quantum = 16 * 1024
+
+// Both directions use the same virtual byte counter, protected by the scheduler mutex.
+type rateFlow struct{ finish uint64 }
+type grant struct {
+	finish uint64
+	bytes  int64
+	done   chan struct{}
+	index  int
+}
+type grantQueue []*grant
+
+func (q grantQueue) Len() int           { return len(q) }
+func (q grantQueue) Less(i, j int) bool { return q[i].finish < q[j].finish }
+func (q grantQueue) Swap(i, j int) {
+	q[i], q[j] = q[j], q[i]
+	q[i].index = i
+	q[j].index = j
+}
+func (q *grantQueue) Push(x any) {
+	g := x.(*grant)
+	g.index = len(*q)
+	*q = append(*q, g)
+}
+func (q *grantQueue) Pop() any {
+	old := *q
+	last := len(old) - 1
+	g := old[last]
+	old[last] = nil
+	*q = old[:last]
+	g.index = -1
+	return g
+}
+
+type rateLimiter struct {
+	mu      sync.Mutex
+	rate    atomic.Int64
+	tokens  float64
+	last    time.Time
+	virtual uint64
+	pending grantQueue
+	running bool
+	wake    chan struct{}
+}
+
+func newRateLimiter() *rateLimiter    { return &rateLimiter{wake: make(chan struct{}, 1)} }
+func (l *rateLimiter) isActive() bool { return l.rate.Load() > 0 }
+func (l *rateLimiter) queued() int {
+	l.mu.Lock()
+	defer l.mu.Unlock()
+	return len(l.pending)
+}
+func (l *rateLimiter) signal() {
+	select {
+	case l.wake <- struct{}{}:
+	default:
+	}
+}
+func (l *rateLimiter) refill(now time.Time) {
+	r := float64(l.rate.Load())
+	// A CPU-capped cgroup may be descheduled for most of a quota period.
+	// Preserve at most one such period of earned service. A rate transition
+	// discards this credit and each connection still competes per quantum.
+	l.tokens = min((float64(quantum) + r*.1), l.tokens+now.Sub(l.last).Seconds()*r)
+	l.last = now
+}
+func (l *rateLimiter) setRate(r int64) {
+	l.mu.Lock()
+	defer l.mu.Unlock()
+	l.refill(time.Now())
+	l.rate.Store(r)
+	l.tokens = min(l.tokens, float64(quantum))
+	if r <= 0 {
+		l.tokens = 0
+		for len(l.pending) > 0 {
+			close(heap.Pop(&l.pending).(*grant).done)
+		}
+	}
+	l.signal()
+}
+
+func (l *rateLimiter) wait(ctx context.Context, f *rateFlow, n int64) error {
+	return l.waitRemaining(ctx, f, &n)
+}
+
+func (l *rateLimiter) waitRemaining(ctx context.Context, f *rateFlow, remaining *int64) error {
+	for *remaining > 0 && l.isActive() {
+		if err := ctx.Err(); err != nil {
+			return err
+		}
+		take := min(*remaining, int64(quantum))
+		l.mu.Lock()
+		if !l.isActive() {
+			l.mu.Unlock()
+			return nil
+		}
+		l.refill(time.Now())
+		if len(l.pending) == 0 && l.tokens >= float64(take) {
+			l.tokens -= float64(take)
+			l.mu.Unlock()
+		} else {
+			f.finish = max(f.finish, l.virtual) + uint64(take)
+			g := &grant{finish: f.finish, bytes: take, done: make(chan struct{})}
+			heap.Push(&l.pending, g)
+			if !l.running {
+				l.running = true
+				go l.serve()
+			} else if g.index == 0 {
+				l.signal()
+			}
+			l.mu.Unlock()
+			select {
+			case <-g.done:
+			case <-ctx.Done():
+				l.mu.Lock()
+				if g.index >= 0 {
+					heap.Remove(&l.pending, g.index)
+					if f.finish == g.finish {
+						f.finish -= uint64(take)
+					}
+					l.signal()
+				} else {
+					*remaining -= take // grant won the race with cancellation
+				}
+				l.mu.Unlock()
+				return ctx.Err()
+			}
+		}
+		*remaining -= take
+	}
+	return ctx.Err()
+}
+
+func (l *rateLimiter) serve() {
+	timer := time.NewTimer(time.Hour)
+	defer timer.Stop()
+	for {
+		l.mu.Lock()
+		if len(l.pending) == 0 {
+			l.running = false
+			l.mu.Unlock()
+			return
+		}
+		l.refill(time.Now())
+		g := l.pending[0]
+		missing := float64(g.bytes) - l.tokens
+		if missing <= 0 {
+			l.tokens -= float64(g.bytes)
+			l.virtual = g.finish
+			heap.Pop(&l.pending)
+			close(g.done)
+			l.mu.Unlock()
+			continue
+		}
+		delay := time.Duration(missing / float64(l.rate.Load()) * float64(time.Second))
+		l.mu.Unlock()
+		timer.Reset(max(delay, time.Microsecond))
+		select {
+		case <-timer.C:
+		case <-l.wake:
+		}
+	}
+}
