diff --git a/app/dispatcher/ratelimit.go b/app/dispatcher/ratelimit.go
new file mode 100644
index 0000000..44cc847
--- /dev/null
+++ b/app/dispatcher/ratelimit.go
@@ -0,0 +1,103 @@
+package dispatcher
+
+import (
+	"os"
+	"strconv"
+	"strings"
+	"sync/atomic"
+	"time"
+
+	"github.com/juju/ratelimit"
+	"github.com/xtls/xray-core/common"
+	"github.com/xtls/xray-core/common/buf"
+)
+
+const (
+	rateLimitEnvVar       = "XRAY_RATELIMIT_FILE"
+	rateLimitPollInterval = 500 * time.Millisecond
+	minBucketCapacity     = 64 * 1024
+)
+
+var (
+	globalRateBucket       atomic.Pointer[ratelimit.Bucket]
+	globalRateLimitEnabled bool
+)
+
+func init() {
+	path := os.Getenv(rateLimitEnvVar)
+	if path == "" {
+		return
+	}
+	globalRateLimitEnabled = true
+	var lastRate int64
+	updateRateLimit(path, &lastRate)
+	go func() {
+		ticker := time.NewTicker(rateLimitPollInterval)
+		defer ticker.Stop()
+		for range ticker.C {
+			updateRateLimit(path, &lastRate)
+		}
+	}()
+}
+
+func updateRateLimit(path string, lastRate *int64) {
+	data, err := os.ReadFile(path)
+	if err != nil {
+		if os.IsNotExist(err) && *lastRate != 0 {
+			*lastRate = 0
+			globalRateBucket.Store(nil)
+		}
+		return
+	}
+	s := strings.TrimSpace(string(data))
+	var rate int64
+	if s != "" {
+		parsed, err := strconv.ParseInt(s, 10, 64)
+		if err != nil {
+			return
+		}
+		rate = parsed
+	}
+	if rate < 0 {
+		rate = 0
+	}
+	if rate == *lastRate {
+		return
+	}
+	*lastRate = rate
+	if rate == 0 {
+		globalRateBucket.Store(nil)
+		return
+	}
+	capacity := rate
+	if capacity < minBucketCapacity {
+		capacity = minBucketCapacity
+	}
+	globalRateBucket.Store(ratelimit.NewBucketWithRate(float64(rate), capacity))
+}
+
+func waitRateLimit(n int64) {
+	if n <= 0 {
+		return
+	}
+	if b := globalRateBucket.Load(); b != nil {
+		b.Wait(n)
+	}
+}
+
+type rateLimitWriter struct {
+	Writer buf.Writer
+}
+
+func (w *rateLimitWriter) WriteMultiBuffer(mb buf.MultiBuffer) error {
+	waitRateLimit(int64(mb.Len()))
+	return w.Writer.WriteMultiBuffer(mb)
+}
+
+func (w *rateLimitWriter) Close() error {
+	return common.Close(w.Writer)
+}
+
+func (w *rateLimitWriter) Interrupt() {
+	common.Interrupt(w.Writer)
+}
diff --git a/app/dispatcher/ratelimit_test.go b/app/dispatcher/ratelimit_test.go
new file mode 100644
index 0000000..483742a
--- /dev/null
+++ b/app/dispatcher/ratelimit_test.go
@@ -0,0 +1,57 @@
+package dispatcher
+
+import (
+	"os"
+	"path/filepath"
+	"testing"
+
+	"github.com/xtls/xray-core/common"
+	"github.com/xtls/xray-core/common/buf"
+)
+
+func TestUpdateRateLimit(t *testing.T) {
+	defer globalRateBucket.Store(nil)
+
+	dir := t.TempDir()
+	path := filepath.Join(dir, "ratelimit")
+
+	var lastRate int64
+	// Missing file keeps bucket nil.
+	updateRateLimit(path, &lastRate)
+	if globalRateBucket.Load() != nil {
+		t.Fatal("expected nil bucket when file does not exist")
+	}
+
+	// Set a positive rate.
+	if err := os.WriteFile(path, []byte("1048576\n"), 0o600); err != nil {
+		t.Fatal(err)
+	}
+	updateRateLimit(path, &lastRate)
+	b1 := globalRateBucket.Load()
+	if b1 == nil {
+		t.Fatal("expected non-nil bucket for positive rate")
+	}
+	if lastRate != 1048576 {
+		t.Fatalf("expected lastRate 1048576, got %d", lastRate)
+	}
+
+	// Same rate should not replace the bucket.
+	updateRateLimit(path, &lastRate)
+	if globalRateBucket.Load() != b1 {
+		t.Fatal("expected bucket pointer to remain unchanged when rate is unchanged")
+	}
+
+	// Write through rateLimitWriter.
+	w := &rateLimitWriter{Writer: buf.Discard}
+	mb := buf.MergeBytes(nil, []byte("hello"))
+	common.Must(w.WriteMultiBuffer(mb))
+
+	// Zero disables the limiter.
+	if err := os.WriteFile(path, []byte("0\n"), 0o600); err != nil {
+		t.Fatal(err)
+	}
+	updateRateLimit(path, &lastRate)
+	if globalRateBucket.Load() != nil {
+		t.Fatal("expected nil bucket when rate is 0")
+	}
+}
