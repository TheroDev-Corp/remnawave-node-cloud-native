+func TestDispatchLinkMarksContext(t *testing.T) {
+	prev := globalRateLimitEnabled
+	globalRateLimitEnabled = true
+	defer func() {
+		globalRateLimitEnabled = prev
+		globalRateLimiter.setRate(0)
+	}()
+	globalRateLimiter.setRate(100000)
+
+	d := &DefaultDispatcher{ohm: &dummyOutboundManager{}}
+	ctx := context.Background()
+	r, w := pipe.New()
+	link := &transport.Link{Reader: r, Writer: w}
+	dest := net.Destination{Network: net.Network_TCP, Address: net.LocalHostIP, Port: 80}
+
+	// DispatchLink wraps outbound and marks ctx
+	_ = d.DispatchLink(ctx, dest, link)
+
+	markedCtx := markRateLimitedContext(ctx)
+	inLink, outLink := d.getLink(markedCtx)
+	if _, ok := inLink.Writer.(*rateLimitWriter); ok {
+		t.Fatal("expected getLink on marked context to skip rate limit")
+	}
+	if _, ok := outLink.Writer.(*rateLimitWriter); ok {
+		t.Fatal("expected getLink on marked context to skip rate limit")
+	}
+}
+
+func TestIsRateLimitActive(t *testing.T) {
+	prev := globalRateLimitEnabled
+	defer func() {
+		globalRateLimitEnabled = prev
+		globalRateLimiter.setRate(0)
+	}()
+
+	globalRateLimitEnabled = false
+	globalRateLimiter.setRate(100000)
+	if IsRateLimitActive(context.Background()) {
+		t.Fatal("expected IsRateLimitActive = false when globalRateLimitEnabled = false")
+	}
+
+	globalRateLimitEnabled = true
+	globalRateLimiter.setRate(0)
+	if IsRateLimitActive(context.Background()) {
+		t.Fatal("expected IsRateLimitActive = false when rate is 0")
+	}
+
+	globalRateLimiter.setRate(100000)
+	if !IsRateLimitActive(context.Background()) {
+		t.Fatal("expected IsRateLimitActive = true when rate > 0 and normal context")
+	}
+
+	apiCtx := session.ContextWithInbound(context.Background(), &session.Inbound{Tag: apiInboundTag})
+	if IsRateLimitActive(apiCtx) {
+		t.Fatal("expected IsRateLimitActive = false for internal API traffic")
+	}
+}
+
+func TestSpliceCopyDisabledWhenRateLimitActive(t *testing.T) {
+	prev := globalRateLimitEnabled
+	globalRateLimitEnabled = true
+	defer func() {
+		globalRateLimitEnabled = prev
+		globalRateLimiter.setRate(0)
+	}()
+	globalRateLimiter.setRate(100000)
+
+	inbound := &session.Inbound{CanSpliceCopy: 1}
+	ctx := session.ContextWithInbound(context.Background(), inbound)
+
+	d := &DefaultDispatcher{}
+	d.getLink(ctx)
+	if inbound.CanSpliceCopy != 3 {
+		t.Fatalf("expected getLink to set CanSpliceCopy=3, got %d", inbound.CanSpliceCopy)
+	}
+
+	inbound2 := &session.Inbound{CanSpliceCopy: 1}
+	ctx2 := session.ContextWithInbound(context.Background(), inbound2)
+	r, w := pipe.New()
+	WrapLink(ctx2, nil, nil, &transport.Link{Reader: r, Writer: w})
+	if inbound2.CanSpliceCopy != 3 {
+		t.Fatalf("expected WrapLink to set CanSpliceCopy=3, got %d", inbound2.CanSpliceCopy)
+	}
+}
