diff --git a/app/dispatcher/ratelimit.go b/app/dispatcher/ratelimit.go
new file mode 100644
index 0000000..7e55349
--- /dev/null
+++ b/app/dispatcher/ratelimit.go
@@ -0,0 +1,274 @@
+package dispatcher
+
+import (
+	"context"
+	"os"
+	"strconv"
+	"strings"
+	"sync"
+	"sync/atomic"
+	"time"
+
+	"github.com/xtls/xray-core/common"
+	"github.com/xtls/xray-core/common/buf"
+	"github.com/xtls/xray-core/common/session"
+)
+
+const (
+	rateLimitEnvVar       = "XRAY_RATELIMIT_FILE"
+	rateLimitPollInterval = 500 * time.Millisecond
+	minBucketCapacity     = 64 * 1024
+	apiInboundTag         = "REMNAWAVE_API_INBOUND"
+	apiOutboundTag        = "REMNAWAVE_API"
+)
+
+type rateLimitMarkKey struct{}
+
+var (
+	globalRateLimiter      atomic.Pointer[rateLimiter]
+	globalRateLimitEnabled bool
+)
+
+func init() {
+	path := os.Getenv(rateLimitEnvVar)
+	if path == "" {
+		return
+	}
+	globalRateLimitEnabled = true
+	var lastRate int64
+	updateRateLimit(path, &lastRate)
+	go func() {
+		ticker := time.NewTicker(rateLimitPollInterval)
+		defer ticker.Stop()
+		for range ticker.C {
+			updateRateLimit(path, &lastRate)
+		}
+	}()
+}
+
+// rateLimiter is a context-aware token bucket limiter that wakes waiters
+// immediately on context cancellation or when closed/replaced.
+type rateLimiter struct {
+	mu     sync.Mutex
+	rate   float64
+	burst  float64
+	tokens float64
+	last   time.Time
+	closed bool
+	done   chan struct{}
+}
+
+func newRateLimiter(rateBytesPerSec int64) *rateLimiter {
+	burst := float64(rateBytesPerSec)
+	if burst < minBucketCapacity {
+		burst = minBucketCapacity
+	}
+	return &rateLimiter{
+		rate:   float64(rateBytesPerSec),
+		burst:  burst,
+		tokens: burst,
+		last:   time.Now(),
+		done:   make(chan struct{}),
+	}
+}
+
+func (l *rateLimiter) close() {
+	l.mu.Lock()
+	if !l.closed {
+		l.closed = true
+		close(l.done)
+	}
+	l.mu.Unlock()
+}
+
+func (l *rateLimiter) wait(ctx context.Context, n int64) {
+	if n <= 0 {
+		return
+	}
+	if ctx == nil {
+		ctx = context.Background()
+	}
+	remaining := float64(n)
+	for remaining > 0 {
+		if ctx.Err() != nil {
+			return
+		}
+		l.mu.Lock()
+		if l.closed {
+			l.mu.Unlock()
+			return
+		}
+		now := time.Now()
+		if elapsed := now.Sub(l.last).Seconds(); elapsed > 0 {
+			l.tokens += elapsed * l.rate
+			if l.tokens > l.burst {
+				l.tokens = l.burst
+			}
+			l.last = now
+		}
+		if l.tokens >= 1 {
+			take := remaining
+			if take > l.tokens {
+				take = l.tokens
+			}
+			l.tokens -= take
+			remaining -= take
+			if remaining <= 0 {
+				l.mu.Unlock()
+				return
+			}
+		}
+		need := remaining
+		if need > l.burst {
+			need = l.burst
+		}
+		need -= l.tokens
+		if need < 1 {
+			need = 1
+		}
+		waitDur := time.Duration(need / l.rate * float64(time.Second))
+		if waitDur < time.Millisecond {
+			waitDur = time.Millisecond
+		}
+		l.mu.Unlock()
+
+		timer := time.NewTimer(waitDur)
+		select {
+		case <-ctx.Done():
+			timer.Stop()
+			return
+		case <-l.done:
+			timer.Stop()
+			return
+		case <-timer.C:
+		}
+	}
+}
+
+func setGlobalRateLimiter(next *rateLimiter) {
+	prev := globalRateLimiter.Swap(next)
+	if prev != nil {
+		prev.close()
+	}
+}
+
+func updateRateLimit(path string, lastRate *int64) {
+	data, err := os.ReadFile(path)
+	if err != nil {
+		if os.IsNotExist(err) && *lastRate != 0 {
+			*lastRate = 0
+			setGlobalRateLimiter(nil)
+		}
+		return
+	}
+	s := strings.TrimSpace(string(data))
+	var rate int64
+	if s != "" {
+		parsed, err := strconv.ParseInt(s, 10, 64)
+		if err != nil {
+			return
+		}
+		rate = parsed
+	}
+	if rate < 0 {
+		rate = 0
+	}
+	if rate == *lastRate {
+		return
+	}
+	*lastRate = rate
+	if rate == 0 {
+		setGlobalRateLimiter(nil)
+		return
+	}
+	setGlobalRateLimiter(newRateLimiter(rate))
+}
+
+func waitRateLimit(ctx context.Context, n int64) {
+	if n <= 0 {
+		return
+	}
+	if l := globalRateLimiter.Load(); l != nil {
+		l.wait(ctx, n)
+	}
+}
+
+func isInternalAPITraffic(ctx context.Context) bool {
+	if ctx == nil {
+		return false
+	}
+	if inbound := session.InboundFromContext(ctx); inbound != nil && inbound.Tag == apiInboundTag {
+		return true
+	}
+	if session.GetForcedOutboundTagFromContext(ctx) == apiOutboundTag {
+		return true
+	}
+	for _, ob := range session.OutboundsFromContext(ctx) {
+		if ob != nil && ob.Tag == apiOutboundTag {
+			return true
+		}
+	}
+	return false
+}
+
+func markRateLimitedContext(ctx context.Context) context.Context {
+	if ctx == nil {
+		return nil
+	}
+	return context.WithValue(ctx, rateLimitMarkKey{}, true)
+}
+
+func isRateLimitedContext(ctx context.Context) bool {
+	if ctx == nil {
+		return false
+	}
+	v, _ := ctx.Value(rateLimitMarkKey{}).(bool)
+	return v
+}
+
+type rateLimitWriter struct {
+	Writer buf.Writer
+	Ctx    context.Context
+}
+
+func (w *rateLimitWriter) WriteMultiBuffer(mb buf.MultiBuffer) error {
+	waitRateLimit(w.Ctx, int64(mb.Len()))
+	return w.Writer.WriteMultiBuffer(mb)
+}
+
+func (w *rateLimitWriter) Close() error {
+	return common.Close(w.Writer)
+}
+
+func (w *rateLimitWriter) Interrupt() {
+	common.Interrupt(w.Writer)
+}
+
+type rateLimitReader struct {
+	Reader buf.TimeoutReader
+	Ctx    context.Context
+}
+
+func (r *rateLimitReader) ReadMultiBuffer() (buf.MultiBuffer, error) {
+	mb, err := r.Reader.ReadMultiBuffer()
+	if err == nil && !mb.IsEmpty() {
+		waitRateLimit(r.Ctx, int64(mb.Len()))
+	}
+	return mb, err
+}
+
+func (r *rateLimitReader) ReadMultiBufferTimeout(timeout time.Duration) (buf.MultiBuffer, error) {
+	mb, err := r.Reader.ReadMultiBufferTimeout(timeout)
+	if err == nil && !mb.IsEmpty() {
+		waitRateLimit(r.Ctx, int64(mb.Len()))
+	}
+	return mb, err
+}
+
+func (r *rateLimitReader) Close() error {
+	return common.Close(r.Reader)
+}
+
+func (r *rateLimitReader) Interrupt() {
+	common.Interrupt(r.Reader)
+}
