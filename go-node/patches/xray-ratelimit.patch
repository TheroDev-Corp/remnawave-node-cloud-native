+package dispatcher
+
+import (
+	"context"
+	"io"
+	"testing"
+	"time"
+
+	"github.com/xtls/xray-core/common/buf"
+
+	"github.com/xtls/xray-core/transport"
+)
+
+func (d *DefaultDispatcher) PacedTestLinks(ctx context.Context) (*transport.Link, *transport.Link) {
+	return d.getLink(ctx)
+}
+func EnablePacingForTest() (func(int64), func()) {
+	old := globalRateLimitEnabled
+	globalRateLimitEnabled = true
+	return globalRateLimiter.setRate, func() { globalRateLimitEnabled = old; globalRateLimiter.setRate(0) }
+}
+
+type delayedPacket struct{ calls int }
+
+func (p *delayedPacket) ReadMultiBuffer() (buf.MultiBuffer, error) {
+	p.calls++
+	return buf.MultiBuffer{buf.FromBytes([]byte("packet"))}, io.EOF
+}
+func (p *delayedPacket) ReadMultiBufferTimeout(time.Duration) (buf.MultiBuffer, error) {
+	time.Sleep(35 * time.Millisecond)
+	return p.ReadMultiBuffer()
+}
+
+func TestPacedReadUsesOneDeadlineAndRetainsPacket(t *testing.T) {
+	globalRateLimiter.setRate(1)
+	defer globalRateLimiter.setRate(0)
+	source := new(delayedPacket)
+	r := newPacedReader(context.Background(), source, new(rateFlow))
+	defer r.Close()
+	start := time.Now()
+	mb, err := r.ReadMultiBufferTimeout(60 * time.Millisecond)
+	if len(mb) != 0 || err != buf.ErrReadTimeout || time.Since(start) > 85*time.Millisecond {
+		t.Fatalf("timed read: %v after %v", err, time.Since(start))
+	}
+	globalRateLimiter.setRate(0)
+	mb, err = r.ReadMultiBuffer()
+	defer buf.ReleaseMulti(mb)
+	if source.calls != 1 || mb.String() != "packet" || err != io.EOF {
+		t.Fatalf("retry: calls=%d data=%q err=%v", source.calls, mb.String(), err)
+	}
+}
+
+type oneDatagram struct {
+	buf.TimeoutReader
+	payload []byte
+}
+
+func (p oneDatagram) ReadMultiBufferTimeout(time.Duration) (buf.MultiBuffer, error) {
+	return buf.MultiBuffer{buf.FromBytes(p.payload)}, io.EOF
+}
+
+func TestTimedReadRetainsPartialGrant(t *testing.T) {
+	globalRateLimiter.setRate(1)
+	defer globalRateLimiter.setRate(0)
+	globalRateLimiter.mu.Lock()
+	globalRateLimiter.tokens = quantum
+	globalRateLimiter.mu.Unlock()
+	r := newPacedReader(context.Background(), oneDatagram{payload: make([]byte, quantum+12)}, new(rateFlow))
+	defer r.Close()
+	mb, err := r.ReadMultiBufferTimeout(20 * time.Millisecond)
+	if err != buf.ErrReadTimeout || len(mb) != 0 || r.prepaid != quantum {
+		t.Fatalf("first read: %v, prepaid %d", err, r.prepaid)
+	}
+	globalRateLimiter.mu.Lock()
+	globalRateLimiter.tokens = 12
+	globalRateLimiter.mu.Unlock()
+	mb, err = r.ReadMultiBufferTimeout(time.Second)
+	defer buf.ReleaseMulti(mb)
+	if err != io.EOF || len(mb) != 1 || mb.Len() != quantum+12 {
+		t.Fatalf("retry: %v, %d bytes", err, mb.Len())
+	}
+}
