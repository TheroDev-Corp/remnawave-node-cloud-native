{
  "$schema": "https://json-schema.org/draft-07/schema#",
  "title": "Remnanode Values Schema",
  "type": "object",
  "properties": {
    "global": {
      "type": "object",
      "properties": {
        "domain": { "type": "string" }
      },
      "additionalProperties": true
    },
    "replicaCount": {
      "type": "integer",
      "minimum": 1
    },
    "autoUpdate": {
      "type": "object",
      "properties": {
        "enabled": { "type": "boolean" },
        "schedule": { "type": "string" },
        "image": {
          "type": "object",
          "properties": {
            "repository": { "type": "string" },
            "tag": { "type": "string" },
            "pullPolicy": { "type": "string" }
          },
          "additionalProperties": false
        }
      },
      "additionalProperties": false
    },
    "geodata": {
      "type": "object",
      "properties": {
        "enabled": { "type": "boolean" },
        "storageClassName": { "type": "string" },
        "size": { "type": "string" },
        "files": {
          "type": "array",
          "items": {
            "type": "object",
            "properties": {
              "url": { "type": "string" },
              "file": { "type": "string" }
            },
            "required": ["url", "file"],
            "additionalProperties": false
          }
        }
      },
      "additionalProperties": false
    },
    "website": {
      "type": "object",
      "properties": {
        "enabled": { "type": "boolean" },
        "image": {
          "type": "object",
          "properties": {
            "repository": { "type": "string" },
            "tag": { "type": "string" },
            "pullPolicy": { "type": "string" }
          },
          "additionalProperties": false
        },
        "resources": {
          "type": "object",
          "properties": {
            "requests": {
              "type": "object",
              "properties": {
                "cpu": { "type": "string" },
                "memory": { "type": "string" }
              },
              "additionalProperties": false
            },
            "limits": {
              "type": "object",
              "properties": {
                "cpu": { "type": "string" },
                "memory": { "type": "string" }
              },
              "additionalProperties": false
            }
          },
          "additionalProperties": false
        }
      },
      "additionalProperties": false
    },
    "podAnnotations": {
      "type": "object",
      "additionalProperties": { "type": "string" }
    },
    "ioThrottling": {
      "type": "object",
      "properties": {
        "enabled": { "type": "boolean" },
        "cgroupIoMax": { "type": "string" }
      },
      "additionalProperties": false
    },
    "cpuThrottling": {
      "type": "object",
      "properties": {
        "enabled": { "type": "boolean" },
        "highCpuPercent": {
          "type": "integer",
          "minimum": 50,
          "maximum": 99
        },
        "lowCpuPercent": {
          "type": "integer",
          "minimum": 1,
          "maximum": 98
        },
        "rateMbps": {
          "description": "Fallback traffic estimate (Mbps) when Xray telemetry is unavailable.",
          "type": "integer",
          "minimum": 1
        },
        "minRateMbps": {
          "type": "integer",
          "minimum": 1
        }
      },
      "additionalProperties": false
    },
    "tmpfs": {
      "type": "object",
      "properties": {
        "enabled": { "type": "boolean" },
        "tmp": {
          "type": "object",
          "properties": {
            "sizeLimit": { "type": "string" }
          },
          "additionalProperties": false
        },
        "cache": {
          "type": "object",
          "properties": {
            "enabled": { "type": "boolean" },
            "mountPath": { "type": "string" },
            "sizeLimit": { "type": "string" }
          },
          "additionalProperties": false
        }
      },
      "additionalProperties": false
    },
    "leaderElection": {
      "type": "object",
      "properties": {
        "enabled": { "type": "boolean" },
        "leaseName": { "type": "string" }
      },
      "additionalProperties": false
    },
    "peerSync": {
      "type": "object",
      "properties": {
        "enabled": { "type": "boolean" }
      },
      "additionalProperties": false
    },
    "metrics": {
      "type": "object",
      "properties": {
        "enabled": { "type": "boolean" },
        "port": { "type": "integer", "minimum": 1, "maximum": 65535 },
        "path": { "type": "string" },
        "podAnnotations": { "type": "boolean" },
        "scraperNamespace": { "type": "string" }
      },
      "additionalProperties": false
    },
    "podSecurity": {
      "type": "object",
      "properties": {
        "fsGroup": { "type": ["integer", "null"] },
        "unprivilegedPortStart": { "type": ["integer", "null"] },
        "runAsUser": { "type": ["integer", "null"] },
        "runAsGroup": { "type": ["integer", "null"] },
        "runAsNonRoot": { "type": "boolean" }
      },
      "additionalProperties": false
    },
    "ciliumNetworkPolicy": {
      "type": "object",
      "properties": {
        "enabled": { "type": "boolean" }
      },
      "additionalProperties": false
    },
    "node": {
      "type": "object",
      "properties": {
        "image": {
          "type": "object",
          "properties": {
            "repository": { "type": "string" },
            "tag": { "type": "string" },
            "pullPolicy": { "type": "string" }
          },
          "additionalProperties": false
        },
        "apiPort": { "type": "integer", "minimum": 1, "maximum": 65535 },
        "healthPort": { "type": "integer", "minimum": 1, "maximum": 65535 },
        "service": {
          "type": "object",
          "properties": {
            "type": { "type": "string" },
            "port": { "type": "integer", "minimum": 1, "maximum": 65535 },
            "lbPool": { "type": "string" },
            "externalTrafficPolicy": { "type": "string" },
            "loadBalancerIP": { "type": "string" },
            "labels": { "type": "object", "additionalProperties": { "type": "string" } },
            "annotations": { "type": "object", "additionalProperties": { "type": "string" } }
          },
          "additionalProperties": true
        },
        "resources": {
          "type": "object",
          "properties": {
            "requests": {
              "type": "object",
              "properties": {
                "cpu": { "type": "string" },
                "memory": { "type": "string" },
                "ephemeral-storage": { "type": "string" }
              },
              "additionalProperties": false
            },
            "limits": {
              "type": "object",
              "properties": {
                "cpu": { "type": "string" },
                "memory": { "type": "string" },
                "ephemeral-storage": { "type": "string" }
              },
              "additionalProperties": false
            }
          },
          "additionalProperties": false
        },
        "hostNetwork": { "type": "boolean" },
        "disableInstanceLock": { "type": "boolean" },
        "trustedProxies": { "type": "string" },
        "probes": {
          "type": "object",
          "properties": {
            "liveness": {
              "type": "object",
              "properties": {
                "enabled": { "type": "boolean" },
                "initialDelaySeconds": { "type": "integer", "minimum": 0 },
                "periodSeconds": { "type": "integer", "minimum": 1 }
              },
              "additionalProperties": false
            },
            "readiness": {
              "type": "object",
              "properties": {
                "enabled": { "type": "boolean" },
                "initialDelaySeconds": { "type": "integer", "minimum": 0 },
                "periodSeconds": { "type": "integer", "minimum": 1 }
              },
              "additionalProperties": false
            }
          },
          "additionalProperties": true
        },
        "tlsMount": {
          "type": "object",
          "properties": {
            "enabled": { "type": "boolean" },
            "secretName": { "type": "string" },
            "mountPath": { "type": "string" },
            "defaultMode": { "type": "integer" }
          },
          "additionalProperties": true
        },
        "dataDir": { "type": "string" },
        "existingSecret": { "type": "string" },
        "secretKey": { "type": "string" }
      },
      "additionalProperties": true
    },
    "direct": {
      "type": "object",
      "properties": {
        "enabled": { "type": "boolean" },
        "serviceType": { "type": "string" },
        "externalTrafficPolicy": { "type": "string" },
        "loadBalancerIP": { "type": "string" },
        "annotations": { "type": "object", "additionalProperties": { "type": "string" } }
      },
      "additionalProperties": true
    },
    "ingress": {
      "type": "object",
      "properties": {
        "enabled": { "type": "boolean" },
        "tls": {
          "type": "object",
          "properties": {
            "enabled": { "type": "boolean" },
            "redirect": { "type": "boolean" },
            "certResolver": { "type": "string" },
            "secretName": { "type": "string" }
          },
          "additionalProperties": true
        }
      },
      "additionalProperties": true
    },
    "inbounds": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "name": { "type": "string" },
          "port": { "type": "integer", "minimum": 1, "maximum": 65535 },
          "protocol": { "type": "string" },
          "mode": { "type": "string" },
          "sni": {
            "type": "array",
            "items": { "type": "string" }
          }
        },
        "required": ["name", "port", "mode"],
        "additionalProperties": true
      }
    },
    "nodeSelector": {
      "type": "object",
      "additionalProperties": { "type": "string" }
    },
    "tolerations": {
      "type": "array",
      "items": { "type": "object" }
    },
    "affinity": {
      "type": "object",
      "additionalProperties": true
    }
  },
  "additionalProperties": true
}
